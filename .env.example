# ---------------------------------------------------------------------------
# Chore Quests — environment configuration
# Copy to `.env` for local development. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (migrations, seed, and runtime).
# Local example (see README "Local database setup"):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chore_quests_dev?schema=public"

# Separate database used by `pnpm test:integration`. It is reset by the tests.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chore_quests_test?schema=public"

# Better Auth: a long random secret used to sign sessions/tokens.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-secret"

# Public origin of the app (no trailing slash). Used by Better Auth and links.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Child session cookie signing secret (separate from parent auth on purpose).
# Generate one with: openssl rand -base64 32
CHILD_SESSION_SECRET="replace-me-with-a-different-32-byte-random-secret"

# Optional. Set to "development" | "test" | "production". Defaults to NODE_ENV.
# APP_ENV="development"

# Secret for the scheduled maintenance route (/api/cron/maintenance). Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. When unset the route returns 503 (disabled).
# Generate one with: openssl rand -base64 32
CRON_SECRET="replace-me-with-a-16-plus-char-random-secret"

# Outgoing email driver. "dev" stores mail in the email_outbox table (read it at /dev/outbox in
# development) and delivers nothing. See docs/development/EMAIL.md to plug in a real provider.
EMAIL_DRIVER="dev"

# Parents must verify their email before signing in. Set to "false" ONLY on deployments that have
# no email provider yet (verification links could not be delivered).
REQUIRE_EMAIL_VERIFICATION="true"
